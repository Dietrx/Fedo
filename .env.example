# Which analyzer the extension uses: "mock" (offline heuristics) or "jev"
FEDO_ANALYZER=mock

# Jev / TypeSafe (owned by the AI path)
JEV_API_URL=
JEV_API_KEY=

# Speech-to-text for videos (owned by the AI path). Leave empty → videos are not listened to.
# Whisper-style:   STT_API_URL=https://api.openai.com/v1/audio/transcriptions   STT_MODEL=whisper-1
# Chat + audio:    STT_API_URL=https://openrouter.ai/api/v1/chat/completions    STT_MODEL=google/gemini-2.5-flash
STT_API_URL=
STT_API_KEY=
STT_MODEL=

# Image understanding (owned by the AI path): text in images / video posters, signs of AI generation.
# Leave empty → the STT chat model above is reused (works when STT_API_URL is a /chat/completions URL).
VISION_API_URL=
VISION_API_KEY=
VISION_MODEL=
