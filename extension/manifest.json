{
  "manifest_version": 3,
  "name": "Fedo Shield",
  "version": "0.1.0",
  "description": "Live persuasion-technique signals on your social media feed, plus a dashboard of what your feed serves you.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.tiktok.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fedo Shield"
  }
}
