{
  "name": "fedo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "dev:scraper": "node scripts/build.mjs --watch --analyzer=mock",
    "dev:ai": "tsx ai/dev/run-fixtures.ts",
    "eval": "tsx ai/dev/eval.ts",
    "dev:ui": "node scripts/playground.mjs",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "npm run typecheck && npm run check:boundaries && npm run eval && npm run build"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^20.17.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
